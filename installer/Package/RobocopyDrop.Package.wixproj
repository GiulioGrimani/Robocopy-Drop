<Project Sdk="WixToolset.Sdk/6.0.2">
  <Import Project="$(RobocopyDropBuildProps)"
          Condition="'$(RobocopyDropBuildProps)' != '' and Exists('$(RobocopyDropBuildProps)')" />

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>RobocopyDrop-$(UiLanguage)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>$(Culture)</Cultures>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);Publisher=$(Publisher);ProductLanguage=$(ProductLanguage);UiLanguage=$(UiLanguage);Culture=$(Culture);PayloadDir=$(PayloadDir);ExtensionDll=$(ExtensionDll);AssetsDir=$(AssetsDir);DocsDir=$(DocsDir);ProductDescription=$(ProductDescription);DowngradeMessage=$(DowngradeMessage);NetFxMessage=$(NetFxMessage);OsMessage=$(OsMessage);ArchMessage=$(ArchMessage);HandlerDescription=$(HandlerDescription);SettingsShortcutName=$(SettingsShortcutName);SettingsShortcutDescription=$(SettingsShortcutDescription);GuideShortcutName=$(GuideShortcutName);GuideTarget=$(GuideTarget);ReportsShortcutName=$(ReportsShortcutName);ReportsShortcutDescription=$(ReportsShortcutDescription);UpdateShortcutName=$(UpdateShortcutName);UpdateShortcutDescription=$(UpdateShortcutDescription);UninstallShortcutName=$(UninstallShortcutName);UninstallShortcutDescription=$(UninstallShortcutDescription)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Netfx.wixext" Version="6.0.2" />
  </ItemGroup>

  <Target Name="ValidateRobocopyDropBuildProperties" BeforeTargets="BeforeBuild">
    <Error Condition="'$(RobocopyDropBuildProps)' == ''"
           Text="RobocopyDropBuildProps is not set. Use tools\Build-Release.ps1." />
    <Error Condition="'$(ProductVersion)' == ''"
           Text="ProductVersion is missing from the generated build properties." />
    <Error Condition="'$(PayloadDir)' == '' or !Exists('$(PayloadDir)')"
           Text="PayloadDir is missing or does not exist: $(PayloadDir)" />
    <Error Condition="'$(ExtensionDll)' == '' or !Exists('$(ExtensionDll)')"
           Text="ExtensionDll is missing or does not exist: $(ExtensionDll)" />
    <Error Condition="'$(OutputPath)' == ''"
           Text="OutputPath is missing from the generated build properties." />
  </Target>
</Project>
